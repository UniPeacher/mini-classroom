# 模型配置（ADR 0005：业务代码不感知供应商）
# 这里是默认值：在设置页保存过 AI 模型配置后，以设置页为准（存在本机数据库）
# 供应商：openai-compatible（OpenAI 兼容格式）、anthropic、google（Gemini）
MODEL_PROVIDER=openai-compatible
# openai-compatible 必填；anthropic、google 可留空（使用官方地址），走代理时填代理地址
MODEL_BASE_URL=
MODEL_NAME=
# 推理强度：low / medium / high（anthropic 另有 xhigh、max；google 只分 low / medium / high）
MODEL_REASONING_EFFORT=
# 是否支持严格 JSON Schema 结构化输出；不支持时改为 false（退回 json_object 模式）
MODEL_SUPPORTS_STRUCTURED_OUTPUTS=true
# 密钥只放在本地 .env，不提交
MODEL_API_KEY=

# 插画模型（可选）：走 OpenAI 兼容的 /images/generations 接口，讲解可配材质化插画；留空则只用 SVG、Mermaid 画图
IMAGE_MODEL_NAME=
# 地址和密钥默认沿用上面的 MODEL_BASE_URL、MODEL_API_KEY，不同时再填
# IMAGE_BASE_URL=
# IMAGE_API_KEY=

# 服务配置
# 服务端首选端口。前端首选 6101，两者各自最多顺延 20 个；相隔 100 保证顺延范围互不重叠
PORT=6201
DB_PATH=data/weiketang.sqlite
# 开发模式下允许用 X-Dev-Now 请求头覆盖当前时间
DEV_MODE=false

# 学习节奏的默认值（可选）。设置页保存过之后以设置页为准
# SESSION_BUDGET_SECONDS=600   一节微课堂的时间预算（秒）
# MAX_NEW_PER_SESSION=2        每节最多引入的新知识点数
# GENERATION_CONCURRENCY=3     补候选池时同时向模型发起的请求数
